{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinVersions",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "matchCategories": ["rust"],
      "enabled": true
    },
    {
      "description": "First-party packages are reviewed and published by us, so skip the release delay. Keep in sync with minimumReleaseAgeExclude in pnpm-workspace.yaml",
      "matchPackageNames": ["@home-assistant/**"],
      "minimumReleaseAge": null
    },
    {
      "description": "Group Lit packages",
      "groupName": "lit",
      "groupSlug": "lit",
      "matchPackageNames": ["/^lit/", "/^@lit//"]
    },
    {
      "description": "Group Web Awesome packages",
      "groupName": "web-awesome",
      "groupSlug": "web-awesome",
      "matchPackageNames": ["/webawesome/", "/@awesome.me/"]
    },
    {
      "description": "Follow webawesome fork releases (X.Y.Z-ha.N) across upstream versions, and skip the plain upstream syncs",
      "matchPackageNames": ["@home-assistant/webawesome"],
      "allowedVersions": "/-ha\\.\\d+$/",
      "ignoreUnstable": false
    },
    {
      "description": "Group Playwright packages",
      "groupName": "playwright",
      "groupSlug": "playwright",
      "matchPackageNames": ["/^@playwright//", "/^playwright/"]
    },
    {
      "description": "Group testing packages",
      "groupName": "testing",
      "groupSlug": "testing",
      "matchPackageNames": [
        "/^@web/test-runner/",
        "/^@open-wc/testing/",
        "/^sinon/"
      ]
    },
    {
      "description": "Group Rust crates",
      "matchManagers": ["cargo"],
      "groupName": "rust-dependencies",
      "groupSlug": "rust-deps"
    },
    {
      "description": "Group Tauri packages; after the Rust crates rule so the crates stay in step with their npm packages",
      "groupName": "tauri",
      "groupSlug": "tauri",
      "matchPackageNames": ["/^@tauri-apps//", "/^tauri/"]
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "gha"
    },
    {
      "description": "Auto-merge patch updates",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge minor dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
