{
  "name": "hai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:types": "cargo test -p hai-core export_typescript --locked -- --ignored",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint --max-warnings 0 src/ test/",
    "lint:lit": "lit-analyzer \"src/**/*.ts\"",
    "localization:check": "node scripts/check-localization.mjs",
    "test:localization": "node --test scripts/check-localization.test.mjs scripts/import-translations.test.mjs",
    "test:release": "node --test scripts/next-version.test.mjs scripts/updater-manifest.test.mjs",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"{src,test}/**/*.{ts,css,json}\"",
    "format:check": "prettier --check \"{src,test}/**/*.{ts,css,json}\"",
    "test": "npm run test:unit",
    "test:unit": "web-test-runner",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@home-assistant/webawesome": "3.14.0-ha.2",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "~2.8.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "2.4.0",
    "intl-messageformat": "12.1.5",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@actions/artifact": "^6.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "~2.12.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.3",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.0.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.7.1",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "~7.0.0",
    "vite": "^8.1.6"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
